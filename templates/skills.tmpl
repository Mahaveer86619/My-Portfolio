{{- template "base" . -}}
{{ define "content" }}
<div class="container mx-auto p-4">
    <h1 class="text-3xl font-bold mb-4">Skills</h1>
    <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
        {{ range .Resume.Skills }}
        <div class="bg-gray-200 hover:bg-gray-300 rounded-full px-4 py-2 text-center shadow-md transition duration-300 ease-in-out hover:scale-110">
            {{ . }}
        </div>
        {{ end }}
    </div>
</div>
{{ end }}